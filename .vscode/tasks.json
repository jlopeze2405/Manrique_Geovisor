{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Publicar cambios de GitHub Pages automáticamente",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-Command",
        "Start-Process -WindowStyle Hidden -FilePath powershell.exe -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-File','${workspaceFolder}\\.vscode\\auto-publish.ps1')"
      ],
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
